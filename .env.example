# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://darak:darak@localhost:5432/darak?schema=public"
# 서비스 공개 URL (메타데이터/OG/robots에 사용)
APP_URL="http://localhost:3000"
# 업로드 이미지 저장소: 기본은 로컬 디스크(UPLOAD_DIR), STORAGE_DRIVER=s3 이면 S3 호환 스토리지(AWS S3, Cloudflare R2, MinIO),
# STORAGE_DRIVER=db 이면 PostgreSQL에 저장(디스크 없는 무료 호스팅용)
UPLOAD_DIR="./storage/uploads"
# STORAGE_DRIVER="s3"
# S3_BUCKET="darak-media"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="1"   # MinIO 등
# (선택) 테스트/스테이징에서 rate limit 한도를 늘리는 배수. production에서는 비워 둔다.
# RATE_LIMIT_MULTIPLIER=50
# 메일 발송 (비우면 개발 환경에서는 로그로 대신함)
SMTP_URL=""
MAIL_FROM="다락 <no-reply@darak.app>"
# 웹 푸시(VAPID) 키. `npx web-push generate-vapid-keys`로 생성. 비워 두면 푸시 기능이 꺼진 채로 동작한다.
# (실행 시점에 읽으므로 키를 바꿔도 다시 빌드할 필요가 없다. 예전 이름 NEXT_PUBLIC_VAPID_PUBLIC_KEY도 지원)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@darak.app"
